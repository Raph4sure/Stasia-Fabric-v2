# Neon PostgreSQL Connection String (e.g. postgresql://user:pass@ep-xyz.region.aws.neon.tech/neondb?sslmode=require)
DATABASE_URL=
NEON_DATABASE_URL=

# Used to sign admin sessions in production.
JWT_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET"

# Used only when the users table is empty on first startup.
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD"

# Optional first sales staff account.
SALES_STAFF_EMAIL="sales@example.com"
SALES_STAFF_PASSWORD="CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_PASSWORD"

# Cloudinary Configuration for Image Storage & CDN
# Provide your Cloudinary credentials from your Cloudinary console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternatively, provide the single unified Cloudinary URL
CLOUDINARY_URL=
